# Absolute paths for every root-invoked system tool. Calling these by
# basename allowed a poisoned PATH (or a misconfigured sudo policy that
# preserves user PATH) to substitute attacker-controlled binaries into
# the root subprocess chain (audit #25).
SYSCTL = "/usr/sbin/sysctl"
SYSTEM_PROFILER = "/usr/sbin/system_profiler"
POWERMETRICS = "/usr/bin/powermetrics"
NICE = "/usr/bin/nice"
VM_STAT = "/usr/bin/vm_stat"
SYSTEM_HELPER_DIR = "/usr/local/bin"

