def init_colors(scheme):
    curses.start_color()
    curses.use_default_colors()
    fg, bg = COLOR_SCHEMES.get(scheme, COLOR_SCHEMES[2])
    curses.init_pair(1, fg, -1)            # main accent
    curses.init_pair(2, curses.COLOR_WHITE, -1)  # text
    curses.init_pair(3, curses.COLOR_YELLOW, -1)  # warning
    curses.init_pair(4, curses.COLOR_RED, -1)     # hot
    curses.init_pair(5, curses.COLOR_CYAN, -1)    # cool
    curses.init_pair(6, curses.COLOR_GREEN, -1)   # bar fill
    curses.init_pair(7, fg, -1)            # border


def hbar(width, pct, filled_char="█", empty_char="░"):
    """Render a horizontal bar string of given width at pct%."""
    if width <= 0:
        return ""
    fill = int(pct / 100 * width)
    fill = min(fill, width)
    return filled_char * fill + empty_char * (width - fill)


def clamp_pct(pct):
    """Clamp a percentage to the range the UI can safely render."""
    return max(0, min(int(pct), 100))


def compute_bar_layout(total_width, pct, label="", suffix=""):
    """Compute non-overlapping label, bar, and suffix spans for one row."""
    total_width = max(int(total_width), 0)
    pct = clamp_pct(pct)

    label_w = min(len(label), total_width)
    suffix_start = min(max(label_w, total_width - len(suffix)), total_width)
    bar_start = label_w
    bar_end = suffix_start
    bar_w = max(bar_end - bar_start, 0)
    fill_w = min(int(pct / 100 * bar_w), bar_w)

    return {
        "pct": pct,
        "label_span": (0, label_w),
        "bar_span": (bar_start, bar_end),
        "suffix_span": (suffix_start, total_width),
        "bar_width": bar_w,
        "fill_width": fill_w,
        "empty_width": bar_w - fill_w,
    }


def temp_color(temp):
    """Return color pair number based on temperature."""
    if temp < 0:
        return 2
    if temp < 50:
        return 5  # cyan/cool
    if temp < 70:
        return 3  # yellow/warm
    return 4  # red/hot


def draw_box(win, y, x, h, w, title="", color_pair=7):
    """Draw a box with optional title."""
    if h < 2 or w < 4:
        return
    try:
        # Top
        win.addstr(y, x, "┌" + "─" * (w - 2) + "┐", curses.color_pair(color_pair))
        if title:
            tstr = f" {title} "
            tx = x + 2
            if tx + len(tstr) < x + w - 1:
                win.addstr(y, tx, tstr, curses.color_pair(color_pair) | curses.A_BOLD)
        # Sides
        for row in range(y + 1, y + h - 1):
            win.addstr(row, x, "│", curses.color_pair(color_pair))
            try:
                win.addstr(row, x + w - 1, "│", curses.color_pair(color_pair))
            except curses.error:
                pass
        # Bottom
        try:
            win.addstr(y + h - 1, x, "└" + "─" * (w - 2) + "┘", curses.color_pair(color_pair))
        except curses.error:
            pass
    except curses.error:
        pass


def draw_unavailable_box(win, y, x, h, w, title):
    """Draw a titled box reading "data unavailable" in dim warning color.

    Used when a collector (extract_cpu, extract_gpu, get_ram_metrics, ...)
    returns None to signal that the data source failed or schema-drifted.
    The user sees a clear "unavailable" rather than a silent zero.
    """
    draw_box(win, y, x, h, w, title)
    if h >= 2 and w >= 6:
        msg = "data unavailable"
        if len(msg) > w - 4:
            msg = "unavailable"
        mid = y + max(1, h // 2)
        col = x + max(1, (w - len(msg)) // 2)
        safe_addstr(win, mid, col, msg,
                    curses.color_pair(3) | curses.A_DIM, clip_right=x + w - 1)


def safe_addstr(win, y, x, s, attr=0, clip_right=None):
    """addstr that won't crash on boundary writes.

    clip_right, when provided, is an exclusive absolute column bound.
    """
    max_y, max_x = win.getmaxyx()
    if y < 0 or y >= max_y or x >= max_x:
        return
    if x < 0:
        s = s[-x:]
        x = 0
    max_right = max_x
    if clip_right is not None:
        max_right = min(max_right, clip_right)
    available = max_right - x
    if available <= 0:
        return
    if len(s) > available:
        s = s[:available]
    if not s:
        return
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass


def draw_core_row(win, y, x, max_w, label, pct, freq_mhz, temp=None, color_pair=1):
    """Draw a single core row: label bar% freq temp.

    Suffix is anchored to a fixed column from the right so the bar
    can never push it off-screen regardless of fill percentage.
    """
    if max_w < 20:
        return
    pct = clamp_pct(pct)

    pct_str = f"{pct:3d}%"
    freq_str = f"{freq_mhz / 1000:.1f}G" if freq_mhz >= 1000 else f"{freq_mhz}M"
    freq_str = freq_str.rjust(4)  # fixed width so all bars align
    temp_str = f"{temp:4.0f}°C" if temp is not None and temp > 0 else ""

    # Suffix text: " pct freq [temp]"
    suffix = " " + pct_str + " " + freq_str
    if temp_str:
        suffix += " " + temp_str

    label_str = label + " "
    layout = compute_bar_layout(max_w, pct, label=label_str, suffix=suffix)
    clip_right = x + max_w

    # Draw label
    safe_addstr(win, y, x, label_str, curses.color_pair(2) | curses.A_BOLD,
                clip_right=clip_right)
    # Draw bar (fill + empty) — always exactly bar_w characters
    bar_x = x + layout["bar_span"][0]
    fill = layout["fill_width"]
    empty = layout["empty_width"]
    safe_addstr(win, y, bar_x, "█" * fill,
                curses.color_pair(color_pair) | curses.A_BOLD,
                clip_right=clip_right)
    safe_addstr(win, y, bar_x + fill, "░" * empty,
                curses.color_pair(2) | curses.A_DIM,
                clip_right=clip_right)
    # Draw suffix at fixed position
    col = x + layout["suffix_span"][0]
    safe_addstr(win, y, col, " " + pct_str, curses.color_pair(2),
                clip_right=clip_right)
    col += 1 + len(pct_str)
    safe_addstr(win, y, col, " " + freq_str, curses.color_pair(5),
                clip_right=clip_right)
    if temp_str:
        col += 1 + len(freq_str)
        safe_addstr(win, y, col, " " + temp_str, curses.color_pair(temp_color(temp)),
                    clip_right=clip_right)


def draw_fan_row(win, y, x, max_w, label, pct, rpm, color_pair=1):
    """Draw a single fan row: label bar pct% RPMr."""
    if max_w < 20:
        return
    pct = clamp_pct(pct)
    pct_str = f"{pct:3d}%"
    rpm_str = f"{int(rpm)}r"
    rpm_str = rpm_str.rjust(5)
    suffix = " " + pct_str + " " + rpm_str
    label_str = label + " "
    layout = compute_bar_layout(max_w, pct, label=label_str, suffix=suffix)
    clip_right = x + max_w

    safe_addstr(win, y, x, label_str, curses.color_pair(2) | curses.A_BOLD,
                clip_right=clip_right)
    bar_x = x + layout["bar_span"][0]
    fill = layout["fill_width"]
    empty = layout["empty_width"]
    safe_addstr(win, y, bar_x, "█" * fill,
                curses.color_pair(color_pair) | curses.A_BOLD,
                clip_right=clip_right)
    safe_addstr(win, y, bar_x + fill, "░" * empty,
                curses.color_pair(2) | curses.A_DIM,
                clip_right=clip_right)
    col = x + layout["suffix_span"][0]
    safe_addstr(win, y, col, " " + pct_str, curses.color_pair(2),
                clip_right=clip_right)
    col += 1 + len(pct_str)
    safe_addstr(win, y, col, " " + rpm_str, curses.color_pair(5),
                clip_right=clip_right)


def draw_hbar_full(win, y, x, w, pct, label="", color_pair=1):
    """Draw a full-width horizontal bar with label."""
    if w < 10:
        return
    pct = clamp_pct(pct)
    pct_str = f" {pct:3d}%"
    if label:
        label_str = label + " "
    else:
        label_str = ""
    layout = compute_bar_layout(w, pct, label=label_str, suffix=pct_str)
    clip_right = x + w

    if label_str:
        safe_addstr(win, y, x, label_str, curses.color_pair(2),
                    clip_right=clip_right)
    fill = layout["fill_width"]
    empty = layout["empty_width"]
    col = x + layout["bar_span"][0]
    safe_addstr(win, y, col, "█" * fill, curses.color_pair(color_pair) | curses.A_BOLD,
                clip_right=clip_right)
    col += fill
    safe_addstr(win, y, col, "░" * empty, curses.color_pair(2) | curses.A_DIM,
                clip_right=clip_right)
    col = x + layout["suffix_span"][0]
    safe_addstr(win, y, col, pct_str, curses.color_pair(2), clip_right=clip_right)


def draw_spark(win, y, x, w, values, max_val, color_pair=1):
    """Draw a mini sparkline chart."""
    if w < 3 or not values:
        return
    sparks = "▁▂▃▄▅▆▇█"
    # Take last w values
    recent = list(values)[-w:]
    for i, v in enumerate(recent):
        ratio = min(v / max(max_val, 0.01), 1.0)
        idx = int(ratio * (len(sparks) - 1))
        safe_addstr(win, y, x + i, sparks[idx], curses.color_pair(color_pair))


# ── Main Loop ──────────────────────────────────────────────────────────────────

def main(stdscr, args):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(200)
    init_colors(args.color)

    soc = get_soc_info()
    header = (
        f"{soc['name']} "
        f"({soc['p_core_count']}{soc['fast_prefix']}+"
        f"{soc['e_core_count']}{soc['slow_prefix']}+"
        f"{soc['gpu_core_count']}GPU)"
    )

    # SIGTERM (from launchd, tmux kill-session, sudo timeout, etc.) is
    # otherwise lost: the default action exits Python without unwinding the
    # finally block, leaving root powermetrics and /tmp files behind. Funnel
    # SIGTERM through a threading.Event so the loop exits cleanly.
    _stop = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: _stop.set())

    # Unique plist path per instance; never glob a shared prefix.
    pm_path = _setup_pm_path()
    pm_proc = None

    try:
        pm_proc = run_powermetrics(pm_path, interval=args.interval * 1000)

        # One-time lookups
        total_mem_bytes = int(subprocess.check_output(
            [SYSCTL, "-n", "hw.memsize"], text=True).strip())
        temps_helper = _find_helper("silitop-temps")
        fans_helper = _find_helper("silitop-fans")

        # Power history. We size buffers by WALLCLOCK seconds, not by sample
        # count: --interval 5 with maxlen=120 used to retain 10 minutes of
        # history while the sparkline column showed "120 samples", which is
        # not what the user asked for. Clamp the lower bound so very long
        # intervals still keep a usable sparkline length.
        history_seconds = 120
        max_history = max(30, history_seconds // args.interval)
        cpu_power_hist = deque(maxlen=max_history)
        gpu_power_hist = deque(maxlen=max_history)
        avg_window = max(1, args.avg // args.interval)
        cpu_power_avg = deque(maxlen=avg_window)
        gpu_power_avg = deque(maxlen=avg_window)
        cpu_peak = 0
        gpu_peak = 0
        pkg_peak = 0
        freq_cache = {}  # core_id -> last known freq_mhz (fallback for freq=0)

        last_timestamp = None
        waiting = True
        fan_available = True   # latches False only on confirmed-fanless
        fan_data = []
        last_hid_temps = {}    # last successful temps read
        hid_temps = {}
        # Slow-poll cadence in WALLCLOCK seconds; prior code used iteration
        # count which made temperature staleness scale linearly with
        # --interval (3 ticks at --interval 5 = 15 seconds between polls).
        slow_poll_seconds = 3.0
        last_slow_poll_ts = 0.0  # monotonic; 0.0 forces first-iteration poll
        net_in_hist = deque(maxlen=max_history)
        net_out_hist = deque(maxlen=max_history)
        disk_r_hist = deque(maxlen=max_history)
        disk_w_hist = deque(maxlen=max_history)

        while not _stop.is_set():
            key = stdscr.getch()
            if key == ord("q") or key == 27:
                break

            # Detect dead powermetrics. Without this, the file stops advancing
            # but parse_powermetrics keeps returning the last sample (read from
            # the 64K tail), and the timestamp-dedupe path sleeps without ever
            # surfacing the failure. The user would see frozen "live" numbers.
            if pm_proc.poll() is not None:
                stdscr.erase()
                h, w = stdscr.getmaxyx()
                msg = f"powermetrics exited (code={pm_proc.returncode})."
                safe_addstr(stdscr, h // 2, max(0, (w - len(msg)) // 2), msg,
                            curses.color_pair(4) | curses.A_BOLD)
                stdscr.refresh()
                _stop.wait(2.0)
                break

            parsed = parse_powermetrics(pm_path)
            if parsed is None:
                if waiting:
                    stdscr.erase()
                    h, w = stdscr.getmaxyx()
                    msg = "Waiting for powermetrics data..."
                    safe_addstr(stdscr, h // 2, max(0, (w - len(msg)) // 2), msg,
                                curses.color_pair(3))
                    msg2 = "(requires sudo)"
                    safe_addstr(stdscr, h // 2 + 1, max(0, (w - len(msg2)) // 2), msg2,
                                curses.color_pair(2))
                    stdscr.refresh()
                time.sleep(0.5)
                continue

            ts = parsed.get("timestamp")
            if ts and ts == last_timestamp:
                time.sleep(0.1)
                continue
            # Compute the actual elapsed wallclock between successive plist
            # samples. Using args.interval is wrong when the loop falls behind
            # (helper hang, slow render): we would underreport wattage by the
            # factor we lagged. Falls back to args.interval on the first sample
            # or when timestamps are missing/non-arithmetic.
            if last_timestamp is not None and ts is not None:
                try:
                    delta_t_s = max((ts - last_timestamp).total_seconds(), 0.001)
                except (AttributeError, TypeError):
                    delta_t_s = float(args.interval)
            else:
                delta_t_s = float(args.interval)
            last_timestamp = ts
            waiting = False

            # Extract metrics. Any of these can return None on schema drift or
            # subprocess failure; downstream code handles None by rendering an
            # "unavailable" panel instead of propagating zeros.
            cpu_result = extract_cpu(parsed, soc)
            if cpu_result is None:
                cores, cpu_agg = None, None
            else:
                cores, cpu_agg = cpu_result
                # Freq cache: use last known value when powermetrics reports 0
                for core in cores["e_cores"] + cores["p_cores"]:
                    cid = core["id"]
                    if core["freq_mhz"] > 0:
                        freq_cache[cid] = core["freq_mhz"]
                    elif cid in freq_cache:
                        core["freq_mhz"] = freq_cache[cid]
            gpu = extract_gpu(parsed)
            thermal = extract_thermal(parsed)
            net = extract_network(parsed)
            disk = extract_disk(parsed)
            ram = get_ram_metrics(total_mem_bytes)

            # Slow-poll temps and fans on WALLCLOCK seconds (they change
            # slowly and we don't want temperature staleness to scale with
            # --interval). first iteration: last_slow_poll_ts == 0 so the
            # `elapsed >= slow_poll_seconds` branch fires.
            now = time.monotonic()
            if now - last_slow_poll_ts >= slow_poll_seconds:
                # Three-state read: None=broken (keep last_hid_temps), {}=empty
                # (no sensors; rare; still rerender). The prior single-state
                # contract dropped last-known temps on every transient helper
                # failure.
                fresh_temps = read_hid_temps(temps_helper)
                if fresh_temps is not None:
                    last_hid_temps = fresh_temps
                hid_temps = last_hid_temps
                if fan_available:
                    fresh_fans = read_fan_speeds(fans_helper)
                    if fresh_fans is None:
                        # Helper broken (transient SMC contention, version
                        # mismatch). Keep last_fan_data; do NOT latch off.
                        pass
                    elif fresh_fans == []:
                        # Confirmed STATUS|fanless from Swift. Latch.
                        fan_available = False
                        fan_data = []
                    else:
                        fan_data = fresh_fans
                last_slow_poll_ts = now
            cpu_die, gpu_die, other_temps = classify_temps(hid_temps)

            # Power calculations:
            #   cpu_w/gpu_w/ane_w come out of extract_cpu as joules accumulated
            #   over the interval -> divide by elapsed seconds for watts.
            #   package_w is combined_power, already a power in watts -> do NOT
            #   divide. The prior /interval_s here cut Total wattage by 1/N at
            #   --interval=N and could report Total < CPU+GPU+ANE.
            # When the CPU panel is unavailable we leave the wattage variables
            # at None; the render side gates the Power panel on cpu_w is not
            # None so it never formats None with :.1f.
            if cpu_agg is not None:
                cpu_w = cpu_agg["cpu_w"] / delta_t_s
                gpu_w = cpu_agg["gpu_w"] / delta_t_s
                ane_w = cpu_agg["ane_w"] / delta_t_s
                pkg_w = cpu_agg["package_w"]
                cpu_power_hist.append(cpu_w)
                gpu_power_hist.append(gpu_w)
                cpu_power_avg.append(cpu_w)
                gpu_power_avg.append(gpu_w)
                cpu_peak = max(cpu_peak, cpu_w)
                gpu_peak = max(gpu_peak, gpu_w)
                pkg_peak = max(pkg_peak, pkg_w)
            else:
                cpu_w = gpu_w = ane_w = pkg_w = None

            # Network + disk rates (already bytes/sec from powermetrics).
            # We do NOT append None into the sparkline deques: drawing logic
            # assumes numeric values throughout the history. A failed sample
            # is dropped from the sparkline, not coerced to zero.
            if net is not None:
                net_in_rate = net["in_rate"]
                net_out_rate = net["out_rate"]
                net_in_hist.append(net_in_rate)
                net_out_hist.append(net_out_rate)
            else:
                net_in_rate = net_out_rate = None
            if disk is not None:
                disk_r_rate = disk["read_rate"]
                disk_w_rate = disk["write_rate"]
                disk_r_hist.append(disk_r_rate)
                disk_w_hist.append(disk_w_rate)
            else:
                disk_r_rate = disk_w_rate = None

            # ── Draw UI ────────────────────────────────────────────────
            stdscr.erase()
            max_h, max_w = stdscr.getmaxyx()
            if max_h < 10 or max_w < 40:
                safe_addstr(stdscr, 0, 0, "Terminal too small", curses.color_pair(4))
                stdscr.refresh()
                time.sleep(1)
                continue

            row = 0

            # Title bar
            title = f" silitop - {header} "
            safe_addstr(stdscr, row, 0, title.center(max_w),
                        curses.color_pair(1) | curses.A_BOLD | curses.A_REVERSE)
            row += 1

            # ── CPU Cores Section ──────────────────────────────────────
            half_w = max_w // 2
            e_box_w = half_w - 1
            p_box_w = max_w - half_w - 1
            if cores is None or cpu_agg is None:
                # Reserve a small unavailable banner; downstream panels still
                # render so a CPU-extractor failure does not blank the whole UI.
                cpu_box_h = 4
                if row + cpu_box_h < max_h:
                    draw_unavailable_box(stdscr, row, 0, cpu_box_h, max_w, "CPU")
                    row += cpu_box_h
            else:
                e_cores = cores["e_cores"]
                p_cores = cores["p_cores"]
                e_count = len(e_cores)
                p_count = len(p_cores)

                # e_cores = slow tier (M-prefix / E-prefix), p_cores = fast tier
                slow_label = soc["slow_label"]
                fast_label = soc["fast_label"]
                slow_pre = soc["slow_prefix"]
                fast_pre = soc["fast_prefix"]

                cpu_die_vals = [t for _, t in cpu_die]
                cpu_die_max = max(cpu_die_vals) if cpu_die_vals else None
                cpu_temp_str = f"  {cpu_die_max:.0f}°C" if cpu_die_max else ""
                fast_title = f"{fast_label}: {cpu_agg['p_active']}% @ {cpu_agg['p_freq']} MHz"
                slow_title = f"{slow_label}: {cpu_agg['e_active']}% @ {cpu_agg['e_freq']} MHz{cpu_temp_str}"

                fast_box_h = p_count + 2
                slow_box_h = e_count + 2
                cpu_box_h = max(fast_box_h, slow_box_h)

                if row + cpu_box_h < max_h:
                    # Left column: fast tier box + optional Fans box below
                    blank_rows = cpu_box_h - fast_box_h
                    show_fan_box = fan_data and blank_rows >= 3

                    if show_fan_box:
                        draw_box(stdscr, row, 0, fast_box_h, e_box_w, fast_title)
                        fans_box_h = blank_rows
                        draw_box(stdscr, row + fast_box_h, 0, fans_box_h,
                                 e_box_w, "Fans")
                        for fi, fan in enumerate(fan_data):
                            if fi >= fans_box_h - 2:
                                break
                            rpm = fan["rpm"]
                            max_rpm = fan["max_rpm"]
                            pct = int(rpm / max_rpm * 100) if max_rpm > 0 else 0
                            fan_label = f"F{fi+1:<2d}"
                            fan_y = row + fast_box_h + 1 + fi
                            if rpm == 0:
                                safe_addstr(stdscr, fan_y, 2,
                                            fan_label + "  off",
                                            curses.color_pair(2) | curses.A_DIM,
                                            clip_right=e_box_w - 1)
                            else:
                                draw_fan_row(stdscr, fan_y, 2,
                                             e_box_w - 4, fan_label, pct, rpm)
                    else:
                        draw_box(stdscr, row, 0, cpu_box_h, e_box_w, fast_title)

                    # Right column: slow tier box (always full height)
                    draw_box(stdscr, row, half_w, cpu_box_h, p_box_w, slow_title)

                    for i, core in enumerate(p_cores):
                        label = f"{fast_pre}{i+1:<2d}"
                        draw_core_row(stdscr, row + 1 + i, 2, e_box_w - 4,
                                      label, core["active"], core["freq_mhz"])

                    for i, core in enumerate(e_cores):
                        label = f"{slow_pre}{i+1:<2d}"
                        draw_core_row(stdscr, row + 1 + i, half_w + 2, p_box_w - 4,
                                      label, core["active"], core["freq_mhz"])

                    row += cpu_box_h

            # ── GPU Section ────────────────────────────────────────────
            gpu_box_h = 3
            gpu_die_vals = [t for _, t in gpu_die]
            gpu_die_max = max(gpu_die_vals) if gpu_die_vals else None
            if row + gpu_box_h < max_h:
                if gpu is None:
                    draw_unavailable_box(stdscr, row, 0, gpu_box_h, max_w, "GPU")
                else:
                    gpu_temp_str = f"  {gpu_die_max:.0f}°C" if gpu_die_max else ""
                    gpu_title = f"GPU: {gpu['active']}% @ {gpu['freq_mhz']} MHz{gpu_temp_str}"
                    draw_box(stdscr, row, 0, gpu_box_h, max_w, gpu_title)
                    draw_hbar_full(stdscr, row + 1, 2, max_w - 4, gpu["active"])
                row += gpu_box_h

            # ── ANE Section ────────────────────────────────────────────
            ane_box_h = 3
            if row + ane_box_h < max_h:
                if ane_w is None:
                    draw_unavailable_box(stdscr, row, 0, ane_box_h, max_w, "ANE")
                else:
                    ane_pct = min(int(ane_w / soc["ane_max_power"] * 100), 100)
                    ane_title = f"ANE: {ane_pct}% @ {ane_w:.1f}W"
                    draw_box(stdscr, row, 0, ane_box_h, max_w, ane_title)
                    draw_hbar_full(stdscr, row + 1, 2, max_w - 4, ane_pct, color_pair=5)
                row += ane_box_h

            # ── Network + Disk (side by side) ─────────────────────────
            nd_h = 3
            if row + nd_h < max_h:
                net_w = half_w - 1
                disk_w = max_w - half_w - 1
                if net is None:
                    draw_unavailable_box(stdscr, row, 0, nd_h, net_w, "Net")
                else:
                    net_title = (f"Net: \u2193{format_rate(net_in_rate)} "
                                 f"\u2191{format_rate(net_out_rate)}")
                    draw_box(stdscr, row, 0, nd_h, net_w, net_title)
                if disk is None:
                    draw_unavailable_box(stdscr, row, half_w, nd_h, disk_w, "Disk")
                else:
                    disk_title = (f"Disk: R {format_rate(disk_r_rate)} "
                                  f"W {format_rate(disk_w_rate)}")
                    draw_box(stdscr, row, half_w, nd_h, disk_w, disk_title)

                spark_avail = net_w - 4
                if net is not None and spark_avail > 10 and len(net_in_hist) > 1:
                    hw = spark_avail // 2
                    net_in_max = max(max(net_in_hist), 1)
                    net_out_max = max(max(net_out_hist), 1)
                    safe_addstr(stdscr, row + 1, 2, "\u2193", curses.color_pair(5))
                    draw_spark(stdscr, row + 1, 3, min(hw - 1, len(net_in_hist)),
                               net_in_hist, net_in_max, color_pair=5)
                    mid_n = 2 + hw + 1
                    safe_addstr(stdscr, row + 1, mid_n, "\u2191", curses.color_pair(4))
                    draw_spark(stdscr, row + 1, mid_n + 1,
                               min(hw - 1, len(net_out_hist)),
                               net_out_hist, net_out_max, color_pair=4)

                dsk_avail = disk_w - 4
                if disk is not None and dsk_avail > 10 and len(disk_r_hist) > 1:
                    hw = dsk_avail // 2
                    disk_r_max = max(max(disk_r_hist), 1)
                    disk_w_max = max(max(disk_w_hist), 1)
                    safe_addstr(stdscr, row + 1, half_w + 2, "R",
                                curses.color_pair(5))
                    draw_spark(stdscr, row + 1, half_w + 3,
                               min(hw - 1, len(disk_r_hist)),
                               disk_r_hist, disk_r_max, color_pair=5)
                    mid_d = half_w + 2 + hw + 1
                    safe_addstr(stdscr, row + 1, mid_d, "W",
                                curses.color_pair(4))
                    draw_spark(stdscr, row + 1, mid_d + 1,
                               min(hw - 1, len(disk_w_hist)),
                               disk_w_hist, disk_w_max, color_pair=4)

                row += nd_h

            # ── Memory + Power (side by side) ──────────────────────────
            mem_w = half_w - 1
            pow_w = max_w - half_w - 1
            mp_h = 7
            if row + mp_h < max_h:
                # Memory box - gated separately from Power so each can be
                # independently unavailable.
                if ram is None:
                    draw_unavailable_box(stdscr, row, 0, mp_h, mem_w, "Memory")
                else:
                    draw_box(stdscr, row, 0, mp_h, mem_w, "Memory")
                    safe_addstr(stdscr, row + 1, 2,
                                f"RAM: {ram['used_gb']}/{ram['total_gb']} GB ({ram['pct']}%)",
                                curses.color_pair(2))
                    draw_hbar_full(stdscr, row + 2, 2, mem_w - 4, ram["pct"], color_pair=6)
                    if ram["swap_total_gb"] > 0.05:
                        safe_addstr(stdscr, row + 3, 2,
                                    f"Swap: {ram['swap_used_gb']}/{ram['swap_total_gb']} GB",
                                    curses.color_pair(2))
                    else:
                        safe_addstr(stdscr, row + 3, 2, "Swap: inactive",
                                    curses.color_pair(2) | curses.A_DIM)

                    # Memory breakdown (row+4): App / Wired / Compressed / Cached
                    breakdown_full = (
                        f"App {ram['app_gb']}G  Wired {ram['wired_gb']}G  "
                        f"Comp {ram['compressed_gb']}G  Cache {ram['cached_gb']}G"
                    )
                    breakdown_short = (
                        f"App {ram['app_gb']}G W {ram['wired_gb']}G "
                        f"C {ram['compressed_gb']}G"
                    )
                    avail = mem_w - 4
                    if avail >= len(breakdown_full):
                        line = breakdown_full
                    elif avail >= len(breakdown_short):
                        line = breakdown_short
                    else:
                        line = f"App {ram['app_gb']}G  C {ram['compressed_gb']}G"
                    safe_addstr(stdscr, row + 4, 2, line[:avail],
                                curses.color_pair(2) | curses.A_DIM)

                # Power box - gated on cpu_w because Power displays values
                # derived from extract_cpu's agg dict.
                if cpu_w is None:
                    draw_unavailable_box(stdscr, row, half_w, mp_h, pow_w, "Power")
                else:
                    throttle = "no" if thermal == "Nominal" else f"YES ({thermal})"
                    draw_box(stdscr, row, half_w, mp_h, pow_w, "Power")
                    safe_addstr(stdscr, row + 1, half_w + 2,
                                f"CPU: {cpu_w:.1f}W  GPU: {gpu_w:.1f}W  ANE: {ane_w:.1f}W  "
                                f"Total: {pkg_w:.1f}W",
                                curses.color_pair(2))

                    avg_cpu = sum(cpu_power_avg) / max(len(cpu_power_avg), 1)
                    avg_gpu = sum(gpu_power_avg) / max(len(gpu_power_avg), 1)
                    safe_addstr(stdscr, row + 2, half_w + 2,
                                f"CPU avg: {avg_cpu:.1f}W pk: {cpu_peak:.1f}W  "
                                f"GPU avg: {avg_gpu:.1f}W pk: {gpu_peak:.1f}W",
                                curses.color_pair(2) | curses.A_DIM)
                    safe_addstr(stdscr, row + 3, half_w + 2,
                                f"Package peak: {pkg_peak:.1f}W  Throttle: ",
                                curses.color_pair(2))
                    tx = half_w + 2 + len(f"Package peak: {pkg_peak:.1f}W  Throttle: ")
                    tc = 4 if throttle != "no" else 6
                    safe_addstr(stdscr, row + 3, tx, throttle, curses.color_pair(tc))

                # Power sparklines (each gets its own full-width row)
                spark_w = pow_w - 8
                if cpu_w is not None and spark_w > 10 and len(cpu_power_hist) > 1:
                    safe_addstr(stdscr, row + 4, half_w + 2, "CPU ",
                                curses.color_pair(2))
                    draw_spark(stdscr, row + 4, half_w + 6,
                               min(spark_w, len(cpu_power_hist)),
                               cpu_power_hist, soc["cpu_max_power"],
                               color_pair=1)
                    safe_addstr(stdscr, row + 5, half_w + 2, "GPU ",
                                curses.color_pair(2))
                    draw_spark(stdscr, row + 5, half_w + 6,
                               min(spark_w, len(gpu_power_hist)),
                               gpu_power_hist, soc["gpu_max_power"],
                               color_pair=3)

                row += mp_h

            # ── Temperatures Box ───────────────────────────────────────
            has_temps = cpu_die or gpu_die or other_temps
            temp_box_h = 6 if has_temps else 3

            if row + temp_box_h < max_h:
                if has_temps:
                    draw_box(stdscr, row, 0, temp_box_h, max_w, "Temperatures")
                    cy = row + 1

                    # Line 1: CPU Die summary + GPU Die + other highlights
                    cpu_die_avg = (sum(cpu_die_vals) / len(cpu_die_vals)
                                   if cpu_die_vals else 0)
                    gpu_die_avg = (sum(gpu_die_vals) / len(gpu_die_vals)
                                   if gpu_die_vals else 0)
                    parts = []
                    if cpu_die_vals:
                        parts.append(f"CPU Die: {cpu_die_avg:.0f}°C (max {cpu_die_max:.0f}°C)")
                    if gpu_die_vals:
                        parts.append(f"GPU Die: {gpu_die_avg:.0f}°C")
                    for label in ["SSD", "Battery"]:
                        if label in other_temps:
                            parts.append(f"{label}: {other_temps[label]:.0f}°C")
                    safe_addstr(stdscr, cy, 2, "  ".join(parts), curses.color_pair(2))
                    cy += 1

                    # Line 2: CPU die zones
                    if cpu_die:
                        cx = 2
                        safe_addstr(stdscr, cy, cx, "CPU ", curses.color_pair(2) | curses.A_DIM)
                        cx += 4
                        for zone_num, val in cpu_die:
                            entry = f"z{zone_num}:{val:.0f}"
                            if cx + len(entry) + 1 > max_w - 2:
                                break
                            safe_addstr(stdscr, cy, cx, entry,
                                        curses.color_pair(temp_color(val)))
                            cx += len(entry) + 1
                        cy += 1

                    # Line 3: GPU die zones
                    if gpu_die:
                        cx = 2
                        safe_addstr(stdscr, cy, cx, "GPU ", curses.color_pair(2) | curses.A_DIM)
                        cx += 4
                        for zone_num, val in gpu_die:
                            entry = f"z{zone_num}:{val:.0f}"
                            if cx + len(entry) + 1 > max_w - 2:
                                break
                            safe_addstr(stdscr, cy, cx, entry,
                                        curses.color_pair(temp_color(val)))
                            cx += len(entry) + 1
                        cy += 1

                    # Thermal pressure
                    tp_color = 4 if thermal != "Nominal" else 6
                    tp_row = min(cy, row + temp_box_h - 2)
                    safe_addstr(stdscr, tp_row, 2,
                                "Thermal Pressure: ", curses.color_pair(2))
                    safe_addstr(stdscr, tp_row, 2 + len("Thermal Pressure: "),
                                thermal, curses.color_pair(tp_color))
                    row += temp_box_h
                else:
                    safe_addstr(stdscr, row, 0, "─" * max_w, curses.color_pair(7))
                    row += 1
                    tp_color = 4 if thermal != "Nominal" else 6
                    safe_addstr(stdscr, row, 2, "Thermal Pressure: ", curses.color_pair(2))
                    safe_addstr(stdscr, row, 2 + len("Thermal Pressure: "),
                                str(thermal), curses.color_pair(tp_color))
                    row += 1

            # Footer
            if row < max_h:
                footer = " q: quit | silitop "
                safe_addstr(stdscr, min(row, max_h - 1), 0, footer.center(max_w),
                            curses.color_pair(2) | curses.A_DIM)

            stdscr.refresh()
            # _stop.wait returns True if SIGTERM arrived during the sleep.
            if _stop.wait(args.interval * 0.8):
                break

    except KeyboardInterrupt:
        pass
    except RuntimeError as exc:
        # run_powermetrics raised because every sampler set failed to stay up.
        try:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            msg = f"silitop: {exc}"
            safe_addstr(stdscr, h // 2, max(0, (w - len(msg)) // 2), msg,
                        curses.color_pair(4) | curses.A_BOLD)
            stdscr.refresh()
            _stop.wait(3.0)
        except curses.error:
            pass
    finally:
        _cleanup_pm(pm_proc, pm_path)


def entry():
    parser = argparse.ArgumentParser(
        description="silitop: Apple Silicon performance monitor with per-core display"
    )
    parser.add_argument("--interval", type=int, default=1,
                        help="Sampling interval in seconds (default: 1; minimum 1)")
    parser.add_argument("--color", type=int, default=2, choices=range(7),
                        help="Color scheme 0-6 (default: 2/green)")
    parser.add_argument("--avg", type=int, default=30,
                        help="Power averaging window in seconds (default: 30)")
    parser.add_argument("--test-temps", action="store_true",
                        help="Print temperature sensor readings and exit")
    args = parser.parse_args()

    # Validate up front so we never start powermetrics with garbage. The prior
    # code would launch the child subprocess and then ZeroDivisionError or
    # ValueError on deque(maxlen=-1), bypassing the finally cleanup.
    if args.interval < 1:
        parser.error("--interval must be >= 1 (seconds)")
    if args.avg < args.interval:
        parser.error(f"--avg ({args.avg}) must be >= --interval ({args.interval})")

    if args.test_temps:
        temps = read_hid_temps(_find_helper("silitop-temps"))
        if temps is None:
            print("silitop-temps helper failed (missing, crashed, or version "
                  "mismatch). Try: sudo silitop --test-temps", file=sys.stderr)
            sys.exit(2)
        if not temps:
            print("No temperature readings (no sensors found).")
            sys.exit(0)
        for sensor, val in sorted(temps.items()):
            print(f"  {sensor}: {val:.1f}°C")
        sys.exit(0)

    if os.geteuid() != 0:
        print("silitop requires root privileges for powermetrics.")
        print("Run with: sudo silitop")
        sys.exit(1)

    curses.wrapper(lambda stdscr: main(stdscr, args))


if __name__ == "__main__":
    entry()
