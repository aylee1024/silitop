def get_soc_info():
    """Detect SoC name, core topology, GPU cores."""
    info = {
        "name": "Apple Silicon",
        "e_core_count": 4,
        "p_core_count": 4,
        "gpu_core_count": "?",
        # Labels for the two CPU tiers (overridden for M5+)
        "fast_label": "Super",
        "slow_label": "Perf",
        "fast_prefix": "S",
        "slow_prefix": "P",
    }
    try:
        out = subprocess.check_output(
            [SYSCTL, "-n", "machdep.cpu.brand_string"],
            text=True,
        ).strip()
        info["name"] = out
    except Exception:
        pass

    # Detect core tier naming from system_profiler
    try:
        hw = subprocess.check_output(
            [SYSTEM_PROFILER, "SPHardwareDataType"], text=True, timeout=5
        )
        for line in hw.splitlines():
            if "Total Number of Cores" in line:
                # e.g. "6 Super and 12 Performance" or "2 Efficiency and 8 Performance"
                core_desc = line.split(": ", 1)[-1].strip()
                # e.g. "18 (6 Super and 12 Performance)" - extract from parens
                paren = re.search(r"\((.+)\)", core_desc)
                inner = paren.group(1) if paren else core_desc
                # Parse "N TypeA and M TypeB"
                m = re.match(r"(\d+)\s+(\w+)\s+and\s+(\d+)\s+(\w+)", inner)
                if m:
                    fast_count, fast_type = int(m.group(1)), m.group(2)
                    slow_count, slow_type = int(m.group(3)), m.group(4)
                    info["p_core_count"] = fast_count   # perflevel0 = fastest tier
                    info["e_core_count"] = slow_count   # perflevel1 = second tier
                    info["fast_label"] = fast_type       # "Super" on M5
                    info["slow_label"] = slow_type       # "Performance" on M5
                    info["fast_prefix"] = fast_type[0]   # "S"
                    info["slow_prefix"] = slow_type[0]   # "P"
    except Exception:
        pass

    # Fallback to sysctl if system_profiler didn't give us core counts
    if info["p_core_count"] == 4:
        try:
            info["p_core_count"] = int(
                subprocess.check_output(
                    [SYSCTL, "-n", "hw.perflevel0.logicalcpu"], text=True
                ).strip()
            )
            info["e_core_count"] = int(
                subprocess.check_output(
                    [SYSCTL, "-n", "hw.perflevel1.logicalcpu"], text=True
                ).strip()
            )
        except Exception:
            pass
    # GPU core count from display profiler
    try:
        sp = subprocess.check_output(
            [SYSTEM_PROFILER, "-detailLevel", "basic", "SPDisplaysDataType"],
            text=True, timeout=5,
        )
        for line in sp.splitlines():
            if "Total Number of Cores" in line:
                info["gpu_core_count"] = int(line.split(": ")[-1])
                break
    except Exception:
        pass
    # TDP estimates
    name = info["name"]
    if "Ultra" in name:
        info["cpu_max_power"] = 80
        info["gpu_max_power"] = 120
    elif "Max" in name:
        info["cpu_max_power"] = 40
        info["gpu_max_power"] = 60
    elif "Pro" in name:
        info["cpu_max_power"] = 30
        info["gpu_max_power"] = 30
    else:
        info["cpu_max_power"] = 20
        info["gpu_max_power"] = 20
    info["ane_max_power"] = 8.0
    return info


def run_powermetrics(pm_path, interval=1000):
    """Start a powermetrics subprocess writing plist samples to pm_path.

    The caller allocates pm_path (typically via tempfile.mkstemp) so we
    never glob a shared prefix and never race with other instances.
    Raises RuntimeError if every sampler set fails to stay alive past the
    1.5-second probe window. Returns the live Popen on success.
    """
    samplers_options = [
        "cpu_power,gpu_power,thermal,network,disk,smc",
        "cpu_power,gpu_power,thermal,network,disk",
    ]
    last_stderr = ""
    for samplers in samplers_options:
        cmd = [
            NICE, "-n", "10", POWERMETRICS,
            "--samplers", samplers,
            "-o", pm_path,
            "-f", "plist",
            "-i", str(interval),
        ]
        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        except OSError:
            continue
        try:
            proc.wait(timeout=1.5)
        except subprocess.TimeoutExpired:
            return proc
        # Process exited before the probe window ended: sampler set rejected.
        # Capture stderr for diagnostics and try the next option.
        try:
            last_stderr = proc.stderr.read().decode("utf-8", "replace") if proc.stderr else ""
        except (OSError, ValueError):
            last_stderr = ""
    raise RuntimeError(
        "powermetrics failed to start with any sampler set"
        + (f": {last_stderr.strip().splitlines()[-1]}" if last_stderr.strip() else "")
    )


def _setup_pm_path():
    """Create a unique, attacker-unguessable plist path for powermetrics.

    Uses tempfile.mkstemp so /tmp predictability and the cross-instance
    glob-delete bug from the prior implementation are both eliminated.
    """
    pm_fd, pm_path = tempfile.mkstemp(prefix="silitop_pm_", dir="/tmp")
    os.close(pm_fd)
    return pm_path


def _cleanup_pm(pm_proc, pm_path):
    """Terminate the powermetrics subprocess and remove its plist file.

    Idempotent and safe for any combination of (pm_proc, pm_path) being
    None or already-dead. Called from main()'s finally block; SIGTERM
    delivery between Popen and assignment is tolerated.
    """
    if pm_proc is not None:
        try:
            pm_proc.terminate()
        except (ProcessLookupError, OSError):
            pass
        try:
            pm_proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            try:
                pm_proc.kill()
                pm_proc.wait(timeout=1)
            except (subprocess.TimeoutExpired, ProcessLookupError, OSError):
                pass
        except (ProcessLookupError, OSError):
            pass
    if pm_path:
        try:
            os.unlink(pm_path)
        except (FileNotFoundError, OSError):
            pass


def parse_powermetrics(path):
    """Parse the most recent sample from the plist file written by powermetrics.

    Reads only the tail of the file (last 64 KB) instead of the whole
    thing, keeping each cycle O(1) regardless of how long the process
    has been running.  Uses split+iterate (like the original) so that
    a partially-written chunk is skipped gracefully.
    """
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            if size == 0:
                return None
            f.seek(-min(size, 65536), 2)
            data = f.read()
    except (FileNotFoundError, OSError):
        return None
    chunks = data.split(b"\x00")
    for chunk in reversed(chunks):
        if not chunk:
            continue
        try:
            return plistlib.loads(chunk)
        except Exception:
            continue
    return None


def _is_efficiency(name, slow_prefix):
    """Case-insensitive first-character match.

    M1-M4 system_profiler reports lower-case "performance / efficiency"
    while powermetrics cluster names start with upper-case "P-" / "E-".
    The prior == comparison silently misclassified every M1-M4 efficiency
    cluster as performance because 'E' != 'e'. Empty-name fallback is in
    extract_cpu (skip cluster); we still guard here defensively.
    """
    if not name or not slow_prefix:
        return False
    return name[:1].upper() == slow_prefix[:1].upper()


def extract_cpu(parsed, soc):
    """Extract per-core CPU metrics.

    Returns (cores_dict, agg_dict) on success or None when a required field
    is missing. Required: parsed["processor"]["clusters"] and
    parsed["processor"]["combined_power"]. Missing either is treated as a
    schema-drift failure so the caller can render "unavailable" rather than
    presenting silent zeros as live readings.
    """
    proc = parsed.get("processor")
    if not isinstance(proc, dict) or "clusters" not in proc:
        return None
    if "combined_power" not in proc:
        return None
    clusters = proc["clusters"]
    cores = {"e_cores": [], "p_cores": []}
    agg = {}
    e_active_list, p_active_list = [], []
    e_freq_list, p_freq_list = [], []
    for cluster in clusters:
        name = cluster.get("name", "")
        if not name:
            # Skip malformed cluster instead of crashing on name[0] in
            # _is_efficiency. The remaining clusters still feed the panel.
            continue
        is_e = _is_efficiency(name, soc["slow_prefix"])
        bucket = "e_cores" if is_e else "p_cores"
        cluster_freq_hz = cluster.get("freq_hz", 0)
        for cpu in cluster.get("cpus", []):
            active = int((1 - cpu.get("idle_ratio", 1)) * 100)
            core_freq_hz = cpu.get("freq_hz", 0)
            # powermetrics reports freq_hz=0 for cores at 100% utilization;
            # fall back to the cluster-level frequency
            if core_freq_hz > 0:
                freq = int(core_freq_hz / 1e6)
            elif cluster_freq_hz > 0:
                freq = int(cluster_freq_hz / 1e6)
            else:
                freq = 0
            core_id = cpu.get("cpu", 0)
            cores[bucket].append({
                "id": core_id,
                "active": active,
                "freq_mhz": freq,
            })
            if is_e:
                e_active_list.append(active)
                e_freq_list.append(freq)
            else:
                p_active_list.append(active)
                p_freq_list.append(freq)
    agg["e_active"] = int(sum(e_active_list) / max(len(e_active_list), 1))
    agg["p_active"] = int(sum(p_active_list) / max(len(p_active_list), 1))
    agg["e_freq"] = max(e_freq_list) if e_freq_list else 0
    agg["p_freq"] = max(p_freq_list) if p_freq_list else 0
    # Power units: powermetrics reports cpu_energy/gpu_energy/ane_energy as
    # millijoules accumulated over the sampling interval, and combined_power
    # as milliwatts (instantaneous-ish). We /1000 here for both:
    #   *_energy -> joules per interval (caller divides by elapsed seconds)
    #   combined_power -> watts (already a power; caller does NOT divide)
    agg["cpu_w"] = proc.get("cpu_energy", 0) / 1000
    agg["gpu_w"] = proc.get("gpu_energy", 0) / 1000
    agg["ane_w"] = proc.get("ane_energy", 0) / 1000
    agg["package_w"] = proc.get("combined_power", 0) / 1000
    return cores, agg


def extract_gpu(parsed):
    """Returns {"active": pct, "freq_mhz": mhz} or None when the gpu sampler
    block is missing/malformed."""
    gpu = parsed.get("gpu")
    if not isinstance(gpu, dict):
        return None
    if "idle_ratio" not in gpu or "freq_hz" not in gpu:
        return None
    freq = gpu["freq_hz"]
    # GPU freq_hz in powermetrics is already in MHz (despite the key name)
    # matching asitop behavior
    if freq > 1e6:
        freq = int(freq / 1e6)
    else:
        freq = int(freq)
    return {
        "active": int((1 - gpu["idle_ratio"]) * 100),
        "freq_mhz": freq,
    }


def extract_thermal(parsed):
    return parsed.get("thermal_pressure", "Unknown")


def extract_network(parsed):
    """Returns {"in_rate", "out_rate"} bytes/sec, or None when the network
    sampler block is missing/malformed."""
    net = parsed.get("network")
    if not isinstance(net, dict):
        return None
    if "ibyte_rate" not in net or "obyte_rate" not in net:
        return None
    return {"in_rate": net["ibyte_rate"], "out_rate": net["obyte_rate"]}


def extract_disk(parsed):
    """Returns {"read_rate", "write_rate"} bytes/sec, or None when the disk
    sampler block is missing/malformed."""
    dsk = parsed.get("disk")
    if not isinstance(dsk, dict):
        return None
    if "rbytes_per_s" not in dsk or "wbytes_per_s" not in dsk:
        return None
    return {"read_rate": dsk["rbytes_per_s"], "write_rate": dsk["wbytes_per_s"]}


def format_rate(bps):
    """Format bytes/sec as a human-readable rate string."""
    if bps >= 1024 * 1024 * 1024:
        return f"{bps / (1024**3):.1f} GB/s"
    if bps >= 1024 * 1024:
        return f"{bps / (1024**2):.1f} MB/s"
    if bps >= 1024:
        return f"{bps / 1024:.0f} KB/s"
    return f"{bps:.0f} B/s"


def _find_helper(name):
    """Resolve path to a compiled helper binary (once at startup).

    Under sudo (EUID 0), we ONLY trust SYSTEM_HELPER_DIR helpers that are
    root-owned and not group/world-writable. The prior implementation
    preferred the directory next to the Python frontend, which made
    `sudo silitop` happily execute a helper any local user could overwrite
    (audit #7 / safety-security CRIT-2). Non-root invocations (--test-temps
    from a developer's checkout) still resolve repo-local helpers for
    iteration, since they cannot escalate privileges.
    """
    try:
        script_dir = os.path.dirname(os.path.abspath(__file__))
    except NameError:
        script_dir = None
    local = os.path.join(script_dir, name) if script_dir else None
    system = os.path.join(SYSTEM_HELPER_DIR, name)

    if os.geteuid() == 0:
        # Root invocation: refuse to execute a helper unless system-owned.
        try:
            st = os.stat(system)
        except FileNotFoundError:
            return None
        if (st.st_uid != 0 or
                (st.st_mode & stat.S_IWGRP) or
                (st.st_mode & stat.S_IWOTH)):
            return None
        return system

    # Non-root: dev mode. Prefer repo-local, fall back to system.
    if local and os.path.isfile(local):
        return local
    if os.path.isfile(system):
        return system
    return None


HELPER_TIMEOUT_SEC = 1.5
TEMPS_PROTOCOL_HEADER = "silitop-temps v1"
FANS_PROTOCOL_HEADER = "silitop-fans v1"


def _run_helper(helper):
    """Run a helper subprocess. Return its stdout text, or None on any
    failure (missing path, subprocess error, timeout, decode error).

    Shorter timeout than the prior 3.0s so a hung helper does not freeze
    the UI for a full 6s slow-poll cycle (3s temps + 3s fans). 1.5s is
    well above normal helper latency on M5 Pro (helpers take <50ms).
    """
    if not helper:
        return None
    try:
        out = subprocess.check_output(
            [helper], text=True, encoding="utf-8",
            stderr=subprocess.PIPE, timeout=HELPER_TIMEOUT_SEC)
        return out
    except (subprocess.SubprocessError, OSError, UnicodeDecodeError):
        return None


def read_hid_temps(helper):
    """Read temperatures from IOHIDEventSystemClient via silitop-temps.

    Three-state return contract:
      None  - helper broken (missing, crashed, timed out, version mismatch).
              Caller should keep last-known temps and try again next cycle.
      {}    - helper succeeded but reported no sensors (e.g., sandboxed env).
      {...} - sensor_name -> celsius mapping.

    The prior implementation collapsed all three into {} which made the
    main loop hide the temperature pane indefinitely on a transient failure.
    """
    out = _run_helper(helper)
    if out is None:
        return None
    lines = out.splitlines()
    if not lines or lines[0].strip() != TEMPS_PROTOCOL_HEADER:
        # Version mismatch or unexpected output -> treat as broken.
        return None
    temps = {}
    for line in lines[1:]:
        line = line.rstrip()
        if not line or line.startswith("STATUS|"):
            continue
        # Sensor names from the helper are now '|'-escaped (Swift side
        # replaces literal '|' with '/'), so a single rsplit is safe.
        parts = line.rsplit("|", 1)
        if len(parts) != 2:
            continue
        try:
            val = float(parts[1])
        except ValueError:
            continue
        import math
        if not math.isfinite(val):
            continue
        temps[parts[0]] = val
    return temps


def read_fan_speeds(helper):
    """Read fan speeds from SMC via silitop-fans helper.

    Three-state return contract (matches read_hid_temps):
      None  - helper broken (missing, crashed, version mismatch, SMC failure).
              Caller should keep last_fan_data and try again next cycle.
              Crucially: this does NOT latch fan_available=False.
      []    - confirmed-fanless (STATUS|fanless). Latches fan_available=False
              for the rest of the process lifetime.
      [...] - per-fan dicts with rpm and max_rpm.

    The audit's HIGH-2 + CRIT-1 fan findings collapse: a transient SMC blip
    on first poll no longer permanently disables fan reads.
    """
    out = _run_helper(helper)
    if out is None:
        return None
    lines = out.splitlines()
    if not lines or lines[0].strip() != FANS_PROTOCOL_HEADER:
        return None
    fans = []
    saw_fanless = False
    saw_ok = False
    for line in lines[1:]:
        line = line.rstrip()
        if not line:
            continue
        if line == "STATUS|fanless":
            saw_fanless = True
            continue
        if line == "STATUS|ok":
            saw_ok = True
            continue
        if line.startswith("STATUS|"):
            # Other STATUS (smc_unavailable, fnum_read_failed) -> broken.
            return None
        parts = line.split("|")
        if len(parts) != 3:
            continue
        try:
            rpm = float(parts[1])
            max_rpm = float(parts[2])
        except ValueError:
            continue
        import math
        if not (math.isfinite(rpm) and math.isfinite(max_rpm)
                and rpm >= 0 and max_rpm > 0):
            continue
        fans.append({"rpm": rpm, "max_rpm": max_rpm})
    if saw_fanless:
        return []
    if not saw_ok and not fans:
        # Header present but no STATUS line and no fans -> broken.
        return None
    return fans


SENSOR_LABELS = {
    "PMU tcal": None,  # calibration, skip
    "NAND CH0 temp": "SSD",
    "gas gauge battery": "Battery",
}


def classify_temps(temps, gpu_die_zones=2):
    """Classify temperatures into CPU die, GPU die, and other.

    Apple Silicon packs CPU+GPU on one die.  The last *gpu_die_zones*
    tdie sensors cover the GPU area (convention on M1-M5).
    """
    all_die = []  # (zone_num, temp)
    other_temps = {}
    for sensor, val in temps.items():
        if sensor in SENSOR_LABELS:
            label = SENSOR_LABELS[sensor]
            if label:
                other_temps[label] = val
        elif sensor.startswith("PMU tdie"):
            num = sensor.replace("PMU tdie", "")
            try:
                all_die.append((int(num), val))
            except ValueError:
                pass
        elif sensor.startswith("PMU tdev"):
            num = sensor.replace("PMU tdev", "")
            other_temps[f"SoC {num}"] = val
    all_die.sort(key=lambda x: x[0])

    # Split: last gpu_die_zones entries are GPU, rest are CPU
    if len(all_die) > gpu_die_zones:
        cpu_die = all_die[:-gpu_die_zones]
        gpu_die = all_die[-gpu_die_zones:]
    else:
        cpu_die = all_die
        gpu_die = []
    return cpu_die, gpu_die, other_temps


def get_ram_metrics(total_bytes):
    """Memory accounting matched to Activity Monitor 14+.

    Apple's published definition of "Memory Used" in the menu bar / Activity
    Monitor (macOS 14+) is App Memory + Wired Memory + Compressed Memory.
    We use Pages active for app memory and Pages occupied by compressor for
    compressed memory. The prior formula `total - (free + speculative +
    file_backed + purgeable)` treated all file-backed pages as cache and
    under-reported used memory by several GiB on workloads with mapped
    files. Spot check on this M5 Pro host: prior formula reported 21.3 GiB,
    Activity Monitor 14+ formula reports 27.0 GiB.

    Returns the metrics dict, or None when:
      - vm_stat subprocess fails (OSError, timeout, nonzero)
      - vm_stat output is missing any of: Pages active, Pages wired down,
        Pages occupied by compressor

    The caller renders an "unavailable" Memory panel rather than presenting
    silent-zero readings as if they were measured.
    """
    try:
        vm = subprocess.check_output([VM_STAT], text=True, timeout=2)
    except (subprocess.SubprocessError, OSError):
        return None

    page_size = 16384  # Apple Silicon default
    m = re.search(r"page size of (\d+)", vm)
    if m:
        page_size = int(m.group(1))

    f = {}
    for line in vm.splitlines():
        parts = line.split(":", 1)
        if len(parts) == 2:
            key = parts[0].strip()
            val = parts[1].strip().rstrip(".").replace(",", "")
            try:
                f[key] = int(val)
            except ValueError:
                pass

    # Activity Monitor 14+ requires all three counters. Without them we
    # cannot produce a number that matches the menu bar; surface unavailable.
    required = ("Pages active", "Pages wired down",
                "Pages occupied by compressor")
    if not all(k in f for k in required):
        return None

    active      = f["Pages active"]
    wired       = f["Pages wired down"]
    compressed  = f["Pages occupied by compressor"]
    free        = f.get("Pages free", 0)
    spec        = f.get("Pages speculative", 0)
    purge       = f.get("Pages purgeable", 0)
    file_backed = f.get("File-backed pages", 0)

    def gb(pages):
        return round(max(0, pages) * page_size / (1024**3), 1)

    if page_size <= 0:
        return None
    total_pages = total_bytes // page_size

    # Activity Monitor 14+ formula: used = App + Wired + Compressed.
    used_pages = active + wired + compressed
    used_pages = min(max(0, used_pages), max(total_pages, 1))
    free_display = max(0, total_pages - used_pages)
    pct = min(100, int(used_pages / total_pages * 100)) if total_pages else 0

    info = {
        "total_gb": round(total_bytes / (1024**3), 1),
        "used_gb": gb(used_pages),
        "free_gb": gb(free_display),
        "pct": pct,
        "wired_gb": gb(wired),
        "compressed_gb": gb(compressed),
        "app_gb": gb(active),
        "cached_gb": gb(file_backed),
        "swap_total_gb": 0,
        "swap_used_gb": 0,
    }
    # Swap is informational; its failure does not void the whole panel.
    try:
        sw = subprocess.check_output([SYSCTL, "-n", "vm.swapusage"],
                                     text=True, timeout=2)
        m_total = re.search(r"total\s*=\s*([\d.]+)M", sw)
        m_used = re.search(r"used\s*=\s*([\d.]+)M", sw)
        if m_total:
            info["swap_total_gb"] = round(float(m_total.group(1)) / 1024, 1)
        if m_used:
            info["swap_used_gb"] = round(float(m_used.group(1)) / 1024, 1)
    except (subprocess.SubprocessError, OSError):
        pass
    return info


